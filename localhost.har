it-scrollbar {\\n  width: 10px;\\n}\\n.timezone-picker-scroll::-webkit-scrollbar-track {\\n  background: rgba(15, 23, 42, 0.35);\\n  border-radius: 999px;\\n}\\n.timezone-picker-scroll::-webkit-scrollbar-thumb {\\n  background: linear-gradient(180deg, rgba(96, 165, 250, 0.9), rgba(59, 130, 246, 0.72));\\n  border-radius: 999px;\\n  border: 2px solid rgba(8, 18, 37, 0.95);\\n  box-shadow: 0 0 8px rgba(59, 130, 246, 0.22);\\n}\\n.timezone-picker-scroll::-webkit-scrollbar-thumb:hover {\\n  background: linear-gradient(180deg, rgba(147, 197, 253, 0.95), rgba(96, 165, 250, 0.8));\\n  box-shadow: 0 0 10px rgba(96, 165, 250, 0.28);\\n}\\n.task-carousel-scroll {\\n  scrollbar-width: thin;\\n  scrollbar-color: var(--task-carousel-scrollbar-thumb, #2c4f8e) var(--task-carousel-scrollbar-track, #091426);\\n}\\n.task-carousel-scroll::-webkit-scrollbar {\\n  height: 10px;\\n}\\n.task-carousel-scroll::-webkit-scrollbar-track {\\n  background: var(--task-carousel-scrollbar-track, #091426);\\n  border-radius: 999px;\\n}\\n.task-carousel-scroll::-webkit-scrollbar-thumb {\\n  background: linear-gradient(90deg, var(--task-carousel-scrollbar-thumb-start, #24457a), var(--task-carousel-scrollbar-thumb-end, #3779f1));\\n  border-radius: 999px;\\n  border: 2px solid var(--task-carousel-scrollbar-track, #091426);\\n}\\n.task-carousel-scroll::-webkit-scrollbar-thumb:hover {\\n  background: linear-gradient(90deg, var(--task-carousel-scrollbar-thumb-hover-start, #2f5ba0), var(--task-carousel-scrollbar-thumb-hover-end, #4f8fff));\\n}\\n.task-modal-scroll {\\n  scrollbar-width: thin;\\n  scrollbar-color: rgba(84, 141, 240, 0.92) rgba(7, 18, 37, 0.62);\\n  scrollbar-gutter: stable;\\n}\\n.task-modal-scroll::-webkit-scrollbar {\\n  width: 10px;\\n}\\n.task-modal-scroll::-webkit-scrollbar-track {\\n  background: linear-gradient(180deg, rgba(7, 18, 37, 0.7), rgba(4, 12, 26, 0.72));\\n  border-radius: 999px;\\n}\\n.task-modal-scroll::-webkit-scrollbar-thumb {\\n  background: linear-gradient(180deg, rgba(104, 165, 255, 0.96), rgba(52, 112, 228, 0.95));\\n  border-radius: 999px;\\n  border: 2px solid rgba(5, 15, 33, 0.92);\\n  box-shadow: 0 0 10px rgba(61, 132, 255, 0.28);\\n}\\n.task-modal-scroll::-webkit-scrollbar-thumb:hover {\\n  background: linear-gradient(180deg, rgba(144, 194, 255, 0.98), rgba(84, 141, 240, 0.98));\\n  box-shadow: 0 0 12px rgba(96, 165, 250, 0.38);\\n}\\n@media (max-width: 640px) {\\n  .task-modal-scroll {\\n    scrollbar-width: thin;\\n    scrollbar-color: rgba(104, 165, 255, 0.95) rgba(6, 16, 34, 0.74);\\n    scrollbar-gutter: stable both-edges;\\n  }\\n  .task-modal-scroll::-webkit-scrollbar {\\n    width: 8px;\\n  }\\n  .task-modal-scroll::-webkit-scrollbar-track {\\n    background: linear-gradient(180deg, rgba(5, 14, 30, 0.76), rgba(3, 10, 22, 0.78));\\n  }\\n  .task-modal-scroll::-webkit-scrollbar-thumb {\\n    border: 1px solid rgba(4, 12, 25, 0.96);\\n    box-shadow: 0 0 10px rgba(59, 130, 246, 0.34);\\n  }\\n}\\n.ambient-volume-slider {\\n  accent-color: #3b82f6;\\n}\\n.ambient-progress-slider {\\n  accent-color: #60a5fa;\\n}\\n.ambient-progress-slider::-webkit-slider-runnable-track {\\n  height: 6px;\\n  border-radius: 999px;\\n  background: linear-gradient(90deg, rgba(96, 165, 250, 0.4), rgba(51, 65, 85, 0.55));\\n}\\n.ambient-progress-slider::-webkit-slider-thumb {\\n  -webkit-appearance: none;\\n  appearance: none;\\n  margin-top: -4px;\\n  height: 14px;\\n  width: 14px;\\n  border-radius: 999px;\\n  border: 2px solid #0b1220;\\n  background: #93c5fd;\\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.12);\\n}\\n.ambient-progress-slider::-moz-range-track {\\n  height: 6px;\\n  border-radius: 999px;\\n  background: linear-gradient(90deg, rgba(96, 165, 250, 0.4), rgba(51, 65, 85, 0.55));\\n}\\n.ambient-progress-slider::-moz-range-thumb {\\n  height: 14px;\\n  width: 14px;\\n  border-radius: 999px;\\n  border: 2px solid #0b1220;\\n  background: #93c5fd;\\n  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.12);\\n}\\n.ambient-volume-slider::-