            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/features/focus-dashboard/components/TimerPanel.tsx\");import __vite__cjsImport0_react_jsxDevRuntime from \"/node_modules/.vite/deps/react_jsx-dev-runtime.js?v=c7655a4a\"; const Fragment = __vite__cjsImport0_react_jsxDevRuntime[\"Fragment\"]; const jsxDEV = __vite__cjsImport0_react_jsxDevRuntime[\"jsxDEV\"];\nvar _s = $RefreshSig$();\nimport __vite__cjsImport1_react from \"/node_modules/.vite/deps/react.js?v=c7655a4a\"; const useEffect = __vite__cjsImport1_react[\"useEffect\"]; const useRef = __vite__cjsImport1_react[\"useRef\"]; const useState = __vite__cjsImport1_react[\"useState\"];\nimport { FontAwesomeIcon } from \"/node_modules/.vite/deps/@fortawesome_react-fontawesome.js?v=c7655a4a\";\nimport {\n  faLayerGroup,\n  faPause,\n  faPlay\n} from \"/node_modules/.vite/deps/@fortawesome_free-solid-svg-icons.js?v=c7655a4a\";\nimport { useI18n } from \"/src/i18n/index.ts\";\nimport { taskIconMap } from \"/src/features/focus-dashboard/constants/taskOptions.ts\";\nimport { classNames } from \"/src/features/focus-dashboard/utils/classNames.ts\";\nimport { formatSecondsHms } from \"/src/features/focus-dashboard/utils/time.ts\";\nimport { FocusOnlyTimerPanel } from \"/src/features/focus-dashboard/components/FocusOnlyTimerPanel.tsx\";\nimport { TimerModeRail } from \"/src/features/focus-dashboard/components/timer-panel/TimerModeRail.tsx\";\nimport { TimerPanelFooter } from \"/src/features/focus-dashboard/components/timer-panel/TimerPanelFooter.tsx\";\nimport { timerAccentStyles, timerPlayGlowRgbByColor } from \"/src/features/focus-dashboard/components/timer-panel/timerPanelTheme.ts\";\nimport {\n  normalizeStopwatchLabel,\n  parseHmsLabelToDraftParts,\n  parseTimerDraftPartsToSeconds\n} from \"/src/features/focus-dashboard/components/timer-panel/timerPanelUtils.ts\";\nexport function TimerPanel({\n  timeLabel,\n  onToggleFocus,