            "text": "import __vite__cjsImport0_react from \"/node_modules/.vite/deps/react.js?v=c7655a4a\"; const useEffect = __vite__cjsImport0_react[\"useEffect\"]; const useMemo = __vite__cjsImport0_react[\"useMemo\"]; const useState = __vite__cjsImport0_react[\"useState\"];\nimport { getBrowserAppLocale } from \"/src/i18n/index.ts\";\nimport {\n  loginAuth,\n  loginWithGoogleRedirect,\n  logoutAuth,\n  meAuth,\n  registerAuth\n} from \"/src/features/auth/api.ts?t=1772667234234\";\nimport { getBrowserPath, isKnownPath, navigateTo, resolveRoute } from \"/src/features/auth/utils/routing.ts\";\nimport { mapAuthApiUserToSessionUser } from \"/src/features/auth/utils/sessionUser.ts\";\nlet pendingBootstrapMeAuth = null;\nfunction bootstrapMeAuthOnce() {\n  if (!pendingBootstrapMeAuth) {\n    pendingBootstrapMeAuth = meAuth().finally(() => {\n      pendingBootstrapMeAuth = null;\n    });\n  }\n  return pendingBootstrapMeAuth;\n}\nexport function useAuthModule({\n  locale,\n  setLocale,\n  onResetAppBootstrapState,\n  onStopAudioPlayback\n}) {\n  const [sessionUser, setSessionUser] = useState(null);\n  const [authStatus, setAuthStatus] = useState(\"loading\");\n  const [currentPath, setCurrentPath] = useState(() => getBrowserPath());\n  const fallbackDisplayName = locale === \"es\" ? \"Usuario Velor\" : \"Velor User\";\n  const route = useMemo(() => resolveRoute(currentPath), [currentPath]);\n  useEffect(() => {\n    let didCancel = false;\n    const fallbackDisplayNameAtBoot = locale === \"es\" ? \"Usuario Velor\" : \"Velor User\";\n    const bootstrapAuthSession = async () => {\n      setAuthStatus(\"loading\");\n      try {\n        const user = await bootstrapMeAuthOnce();\n        if (didCancel) {\n          return;\n        }\n        if (!user) {\n          setSessionUser(null);\n          setAuthStatus(\"guest\");\n          return;\n        }\n        const nextUser = mapAuthApiUserToSessionUser(user, fallbackDisplayNameAtBoot);\n        setSessionUser(nextUser)