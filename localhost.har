            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import { API_BASE_URL, apiFetch, ensureCsrfCookie, parseJsonResponse } from \"/src/lib/api/http.ts?t=1772667234234\";\nimport {\n  clearMockSessionFromAuth,\n  syncMockSessionFromAuthUser\n} from \"/src/lib/mock/mockBackend.ts\";\nexport async function registerAuth(payload) {\n  await ensureCsrfCookie();\n  const response = await apiFetch(\"/api/v1/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify(payload)\n  });\n  const json = await parseJsonResponse(response, \"Register failed\");\n  syncMockSessionFromAuthUser(json.data.user);\n  return json;\n}\nexport async function loginAuth(payload) {\n  await ensureCsrfCookie();\n  const response = await apiFetch(\"/api/v1/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify(payload)\n  });\n  const json = await parseJsonResponse(response, \"Login failed\");\n  syncMockSessionFromAuthUser(json.data.user);\n  return json;\n}\nexport async function meAuth() {\n  const response = await apiFetch(\"/api/v1/auth/me\", { method: \"GET\" });\n  if (response.status === 401) {\n    clearMockSessionFromAuth();\n    return null;\n  }\n  const json = await parseJsonResponse(response, \"Auth session lookup failed\");\n  syncMockSessionFromAuthUser(json.data);\n  return json.data;\n}\nexport async function logoutAuth() {\n  await ensureCsrfCookie();\n  const response = await apiFetch(\"/api/v1/auth/logout\", { method: \"POST\" });\n  if (response.status === 401) {\n    clearMockSessionFromAuth();\n    return { message: \"Logged out.\" };\n  }\n  const json = await parseJsonResponse(response, \"Logout failed\");\n  clearMockSessionFromAuth();\n  return json;\n}\nexport function loginWithGoogleRedirect(intent) {\n  if (typeof window === \"undefined\") {\n    return;\n  }\n  const query = intent ? `?intent=${intent}` : \"\";\n  window.location.href = `${API_BASE_URL}/api/v1/auth/google/redirect${query}`;\n}\n\n//# sourceMappingURL=data:application/json;base64,"
