            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_API_BASE_URL\": \"http://localhost:8001\", \"VITE_REVERB_APP_KEY\": \"fh3pyxonhrc73tmkpjex\", \"VITE_REVERB_HOST\": \"localhost\", \"VITE_REVERB_PORT\": \"8080\", \"VITE_REVERB_SCHEME\": \"http\"};import Echo from \"/node_modules/.vite/deps/laravel-echo.js?v=c7655a4a\";\nimport __vite__cjsImport1_pusherJs from \"/node_modules/.vite/deps/pusher-js.js?v=c7655a4a\"; const Pusher = __vite__cjsImport1_pusherJs.__esModule ? __vite__cjsImport1_pusherJs.default : __vite__cjsImport1_pusherJs;\nimport { API_BASE_URL } from \"/src/lib/api/http.ts?t=1772667234234\";\nlet echoSingleton = null;\nlet echoConfigSignature = null;\nexport function getOrCreateReverbEchoClient() {\n  if (typeof window === \"undefined\") {\n    return null;\n  }\n  const config = resolveReverbConfig();\n  if (!config) {\n    return null;\n  }\n  const signature = JSON.stringify(config);\n  if (echoSingleton && echoConfigSignature === signature) {\n    return echoSingleton;\n  }\n  if (echoSingleton) {\n    try {\n      echoSingleton.disconnect();\n    } catch {\n    }\n    echoSingleton = null;\n  }\n  window.Pusher = Pusher;\n  echoSingleton = new Echo({\n    broadcaster: \"reverb\",\n    key: config.appKey,\n    wsHost: config.host,\n    wsPort: config.port,\n    wssPort: config.port,\n    forceTLS: config.scheme === \"https\",\n    enabledTransports: [\"ws\", \"wss\"],\n    authEndpoint: `${API_BASE_URL}/broadcasting/auth`,\n    auth: {\n      headers: {\n        ...config.xsrfToken ? { \"X-XSRF-TOKEN\": config.xsrfToken } : {}\n      }\n    },\n    authorizer: (channel) => ({\n      authorize: async (socketId, callback) => {\n        try {\n          let xsrfToken = readCookieValue(\"XSRF-TOKEN\");\n          if (!xsrfToken) {\n            await fetch(`${API_BASE_URL}/sanctum/csrf-cookie`, {\n              method: \"GET\",\n              credentials: \"includ